# ==============================================================================
# FARMHOUSE WHATSAPP CENTER - CONFIGURACIÓN DE ENTORNO (PLANTILLA DE EJEMPLO)
# Copia este archivo como '.env' en el directorio 'backend/' y completa con tus credenciales.
# ==============================================================================

ENVIRONMENT=development
APP_NAME=Farmhouse WhatsApp Center
API_V1_STR=/api

# Servidor FastAPI
HOST=127.0.0.1
PORT=8000
DEBUG=True

# MySQL 8+ Database (Base de Datos Principal)
DB_SERVER=localhost
DB_PORT=3306
DB_NAME=FarmhouseWhatsAppCenter
DB_USER=root
DB_PASSWORD=
DATABASE_URL=mysql+pymysql://root:@localhost:3306/FarmhouseWhatsAppCenter?charset=utf8mb4

# Seguridad y Tokens JWT (Generar una clave segura aleatoria en producción)
SECRET_KEY=cambiar_por_una_clave_secreta_aleatoria_muy_larga_en_produccion_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes CORS permitidos (separados por coma; 'null' solo para desarrollo local con file://)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000,null

# WhatsApp Service Layer (mock | meta)
WHATSAPP_MODE=mock
META_WA_API_URL=https://graph.facebook.com/v20.0
META_WA_PHONE_NUMBER_ID=tu_phone_number_id_aqui
META_WA_ACCESS_TOKEN=tu_access_token_de_meta_aqui
META_WA_VERIFY_TOKEN=tu_verify_token_personalizado_para_el_webhook
META_APP_SECRET=tu_app_secret_de_meta_para_firmas_hmac
META_WA_DISPLAY_NUMBER=50760000000
PUBLIC_BASE_URL=https://tu-dominio-publico.example

# Botón de Pago Yappy V2 (credenciales emitidas por Yappy Comercial)
# IMPORTANTE: las credenciales de UAT (pruebas) y de producción son de cuentas DISTINTAS y
# NUNCA se mezclan — usar unas credenciales contra la URL base del otro entorno falla. Se
# generan en el portal web de Yappy Comercial: Productos -> Botón de Pago -> "Generar clave
# secreta" (la doc oficial: https://yappy-docs.vercel.app/boton-pago/credentials).
#   UAT (pruebas):       YAPPY_API_BASE_URL=https://api-comecom-uat.yappycloud.com
#                        portal de pruebas: https://comwebuat.yappycloud.com/
#   Producción (real):   YAPPY_API_BASE_URL=https://apipagosbg.bgeneral.cloud
#                        portal real: https://comercial.yappy.com.pa/
YAPPY_ENABLED=False
YAPPY_MERCHANT_ID=tu_id_de_comercio
YAPPY_SECRET_KEY=tu_clave_secreta_base64
# Debe coincidir exactamente con el dominio registrado en Yappy Comercial.
YAPPY_DOMAIN=https://tu-dominio-publico.example
YAPPY_API_BASE_URL=https://apipagosbg.bgeneral.cloud
YAPPY_BUTTON_CDN_URL=https://bt-cdn.yappy.cloud/v1/cdn/web-component-btn-yappy.js

# Respaldo de preguntas frecuentes con IA (ver services/faq_bot.py): solo responde texto libre
# que no coincidió con ningún botón/intención del flujo guiado. Apagado por defecto.
FAQ_BOT_ENABLED=False
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Web Push (Notificaciones push del navegador vía VAPID)
# Generar el par de claves con: python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); ..."
# o con la CLI: vapid --gen
VAPID_PUBLIC_KEY=tu_clave_publica_vapid_base64url
VAPID_PRIVATE_KEY=tu_clave_privada_vapid_base64url
VAPID_CLAIM_SUB=mailto:admin@farmhouse.pa
