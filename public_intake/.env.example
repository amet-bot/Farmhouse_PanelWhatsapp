# Buzón público del formulario del colaborador. Estas claves se generan con tools/gen_keys.py
# (no inventes ni reutilices claves de otros sistemas).

# Llave PÚBLICA para cifrar en el navegador (la privada vive solo en Farmhouse Link).
PUBLIC_KEY=

# Clave con la que Farmhouse Link administra este buzón (>= 32 caracteres). Es la misma que
# INTAKE_ADMIN_KEY en Farmhouse Link. Sin ella, la administración queda apagada.
ADMIN_KEY=

ENVIRONMENT=production

# Base de datos propia, SEPARADA de la de Farmhouse Link (un MySQL del plugin de este proyecto, o un
# volumen para SQLite: sqlite:////data/intake.db). Sin esta variable usa un archivo local.
DATABASE_URL=
